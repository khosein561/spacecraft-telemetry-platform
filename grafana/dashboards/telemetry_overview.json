     "rawQuery": true,
     "editorMode": "code",
     "rawSql": "SELECT channel_id, detector, start_time, end_time, round(score::numeric,2) AS score FROM anomalies WHERE $__timeFilter(start_time) ORDER BY start_time DESC LIMIT 50"
