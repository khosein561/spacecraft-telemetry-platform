# Copy to .env (never commit .env). These are LOCAL dev defaults, not real credentials.
KAFKA_BOOTSTRAP=localhost:9092
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=telemetry
POSTGRES_USER=telemetry
POSTGRES_PASSWORD=change_me
# Optional: incoming-webhook URL for alerts (http/https only). Leave empty to log alerts instead.
ALERT_WEBHOOK_URL=
DATA_DIR=data/raw
CADENCE_SECONDS=60
